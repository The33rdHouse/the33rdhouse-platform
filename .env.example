# Canonical Content Core — Phase 1 only
# Copy to a local/secret-managed .env. Never commit live credentials.
# Payment/Stripe variables are intentionally absent because payments are outside Phase 1.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the33rdhouse
PORT=3000
SOURCE_EVIDENCE_DIR=source-evidence

# Cloudflare R2 — required only for `pnpm media:sync -- --commit`
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=


# Console: exact browser origin; mutation requests fail closed if omitted.
APP_ORIGIN=http://127.0.0.1:5173
# Private reviewed exhibits only; never point this at raw source archives.
# EXHIBIT_ROOT=/absolute/path/to/reviewed-exhibits
