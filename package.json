{
  "name": "@the33rdhouse/canonical-content-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && pnpm build:client",
    "check": "tsc --noEmit && pnpm check:client",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "sources:inventory": "tsx scripts/inventory-sources.ts",
    "sources:import": "tsx scripts/import-sources.ts",
    "media:sync": "tsx scripts/sync-media.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "check:client": "tsc -p client/tsconfig.json",
    "console:session": "tsx scripts/create-console-session.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.4.4",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "lucide-react": "^1.46.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "superjson": "^2.2.2",
    "unzipper": "^0.12.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
